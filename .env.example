ASR_API_KEY=replace-with-a-long-random-secret

# One model replica per device.
ASR_DEVICES=cuda:0

# Multiple GPU replicas.
# ASR_DEVICES=cuda:0,cuda:1

ASR_PRELOAD=false
ASR_LOCAL_FILES_ONLY=false
ASR_MAX_AUDIO_SECONDS=24
ASR_MAX_UPLOAD_BYTES=26214400
ASR_MAX_PENDING_REQUESTS=32
ASR_QUEUE_TIMEOUT_SECONDS=30
ASR_INFERENCE_TIMEOUT_SECONDS=300

ASR_BIND_ADDRESS=127.0.0.1
ASR_PUBLISHED_PORT=8090
